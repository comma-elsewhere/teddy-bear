[resource]
script = ExtResource("1_bgxjb")
patient_records = Array[String](["SCARLET RUMEN, Age 5", "Clean and restore to factory condition.", "Submitted for routine post-mortem sanitation by Head Physician. Minor distress from the parents has been noted.", "Patient expired from acute complications via lymphoblastic leukemia.", "Treatment involved repeated chemotherapy cycles and long-term inpatient care. Medical complications during final treatment stage included infection and severe organ failure. Parents appear to be projecting grief onto the expired patient's toy. Handle with care."])
audio_files = Array[AudioStreamOggVorbis]([ExtResource("1_48qjf"), ExtResource("2_6y4tm")])
subtitles_1 = Array[String](["Scarlet: Bunny... It’s okay. I know you're scared, but they said it won’t hurt as much this time. You can use my blankie, here. See? Now you’re brave like a superhero.", "Nurse: It’s time to start your big kid medicine, are you ready?", "Scarlet: Can Bunny stay?", "Nurse: (sigh) Yes, of course.", "Scarlet: If I fall asleep again... Make sure he doesn’t get scared."])
subtitles_2 = Array[String](["Scarlet: Mommy, I'm... cold.", "Mom: You're cold? Oh baby, you're burning up. Can I get you a blanket? Some more tea?", "Scarlet: I dunno, I feel all funny inside... and tired...", "Mom: Well, you close your eyes for a bit and rest, okay? I'll go get you something warm to drink.", "(Various sounds as Scarlet expires)", "Mom: All the nurses have is Razzle Tazz, so I put some honey... Scarlet...?", "(Distress and grief)"])
metadata/_custom_type_script = "uid://bu8lh7k2adhio"
