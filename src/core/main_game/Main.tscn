[sub_resource type="GDScript" id="GDScript_abx1x"]
resource_name = "RedLightButtonArea"
script/source = "extends Area2D

func _enter_tree() -> void:
	input_event.connect(_on_click)
	
func _on_click(_viewport: Node, event: InputEvent, _shape_idx: int) -> void:
	if event.is_action_pressed(\"click\") and !%ChuteAnimation.is_playing():
		%ChuteAnimation.play(\"door_slide\")
"

[sub_resource type="CircleShape2D" id="CircleShape2D_xot5u"]
radius = 83.198555

[sub_resource type="GDScript" id="GDScript_xot5u"]
resource_name = "GreenLightButtonArea"
script/source = "extends Area2D

func _enter_tree() -> void:
	input_event.connect(_on_click)
	
func _on_click(_viewport: Node, event: InputEvent, _shape_idx: int) -> void:
	if event.is_action_pressed(\"click\") and !%ChuteAnimation.is_playing():
		%ChuteAnimation.play_backwards(\"door_slide\")
"

[sub_resource type="GDScript" id="GDScript_t6eft"]
resource_name = "ChuteInteractArea"
script/source = "extends Area2D

func _enter_tree() -> void:
	body_entered.connect(_clear_toy_body)
	visibility_changed.connect(_toggle_monitoring)

func _clear_toy_body(body: Node2D) -> void:
	if body.is_in_group(\"ToyBody\"):
		get_tree().call_group(\"ToyMonitor\", \"clear_current_toy\")
		#set_deferred(\"monitoring\", false) # TEMP

func _toggle_monitoring() -> void:
	monitoring = visible
"

