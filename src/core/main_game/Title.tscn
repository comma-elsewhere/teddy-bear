[sub_resource type="GDScript" id="GDScript_ycvdl"]
resource_name = "PlayGameButton"
script/source = "extends Button

func _enter_tree() -> void:
	mouse_entered.connect(_toggle_visible_label.bind(true))
	mouse_exited.connect(_toggle_visible_label.bind(false))
	button_up.connect(_load_game)
	
func _toggle_visible_label(mouse_hover: bool) -> void:
	%TitleLabel.visible = !mouse_hover
	%HoverPlay.visible = mouse_hover
	
func _load_game() -> void:
	get_tree().change_scene_to_file(\"res://src/core/main_game/Main.tscn\")
"

